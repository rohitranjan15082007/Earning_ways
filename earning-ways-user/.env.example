# User app environment
# Copy to `.env.local` (git-ignored) as needed.

# Backend API base URL. Default: http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api

# Dev-only preview mode: session seed hota hai aur API calls src/dev/fixtures.ts se aate hain,
# isliye MySQL/backend ke bina bhi saare pages khulte hain. Production build me iska koi asar nahi.
# Logout dekna ho to URL me ?loggedout=1 lagao.
VITE_DEV_PREVIEW=true
