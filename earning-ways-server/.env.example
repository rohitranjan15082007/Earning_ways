# Required for issuing and verifying tokens; at least 32 bytes.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
DATABASE_URL=

# Optional; defaults to 4000 when unset.
PORT=

# Existing integrations (configure before using these features)
USER_EMAIL=
EMAIL_APP_PASSWORD=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_FOLDER=

# Optional defaults for the Telegram Stars (INR) payment rail — the only payment
# method this platform has. The admin panel is the primary source of truth
# (Payments -> Bot & Pricing Settings); these are only fallbacks so a fresh
# deployment can be bootstrapped before the first admin login. Leave them empty
# to keep the checkout hidden.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Stars charged per INR 1 invested (e.g. 0.55).
STARS_PER_INR=
TELEGRAM_STARS_MAX_PER_INVOICE=10000
TELEGRAM_STARS_ENABLED=false
# Send every Bot API call to Telegram's dedicated test environment (the method
# name gets a /test/ prefix). Keep it false in production; use it to exercise
# the Stars flow without real Stars.
TELEGRAM_TEST_ENV=false
